<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5E6A8"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#3B3320"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#8A7A45"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B4A20"/>
    <SolidColorBrush x:Key="TaskLineBrush" Color="#C9B36B"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EFD98A"/>

    <!-- Botão estilo Windows 7 Aero: gradiente, brilho superior, borda sutil -->
    <Style x:Key="Win7ButtonBase" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="#2B2B2B"/>
        <Setter Property="FontFamily" Value="Marlett"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Base" CornerRadius="2" BorderThickness="1" BorderBrush="#7A7A7A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FDFDFD" Offset="0"/>
                                    <GradientStop Color="#E4E4E4" Offset="0.45"/>
                                    <GradientStop Color="#C7C7C7" Offset="0.5"/>
                                    <GradientStop Color="#D9D9D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="2,2,0,0" Margin="1,1,1,0" VerticalAlignment="Top" Height="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter x:Name="Icon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Base" Property="BorderBrush" Value="#4A90D9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Base" Property="Background" Value="#B9B9B9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MinimizeButtonStyle" TargetType="Button" BasedOn="{StaticResource Win7ButtonBase}">
        <Setter Property="Content" Value="0"/>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Content" Value="r"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="Marlett"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Base" CornerRadius="2" BorderThickness="1" BorderBrush="#A33">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E9A5A5" Offset="0"/>
                                    <GradientStop Color="#D96A6A" Offset="0.45"/>
                                    <GradientStop Color="#C23F3F" Offset="0.5"/>
                                    <GradientStop Color="#D06767" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="2,2,0,0" Margin="1,1,1,0" VerticalAlignment="Top" Height="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Base" Property="BorderBrush" Value="#7A1010"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
