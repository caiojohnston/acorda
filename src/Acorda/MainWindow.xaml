<Window x:Class="Acorda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Acorda.ViewModels"
        Title="acorda" Height="460" Width="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>

        <!-- Botões de item do popup de config: sem o retângulo azul padrão do Windows no hover -->
        <Style x:Key="ItemPopupStyle" TargetType="Button">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões P/M/G: mesma ideia, com borda fixa -->
        <Style x:Key="TamanhoPopupStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MutedForegroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}" ClipToBounds="True"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="EscalaJanela" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Grid Grid.Row="0" Height="34" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="acorda" Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="{DynamicResource FontSizeNormal}" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="BtnConfig" Content="&#x2699;" Width="26" Height="24" Background="Transparent"
                            BorderThickness="0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12"
                            Cursor="Hand" Click="BtnConfig_Click" ToolTip="Tema"/>
                    <Button Style="{DynamicResource MinimizeButtonStyle}" Click="Minimizar_Click"/>
                    <Button Style="{DynamicResource CloseButtonStyle}" Click="Fechar_Click"/>
                </StackPanel>
            </Grid>

            <!-- Popup de temas -->
            <Popup x:Name="PopupTemas" PlacementTarget="{Binding ElementName=BtnConfig}" Placement="Bottom"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource MutedForegroundBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="8" ClipToBounds="True" Margin="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button Content="Escuro" Style="{StaticResource ItemPopupStyle}" Click="TemaEscuro_Click"/>
                        <Button Content="Claro" Style="{StaticResource ItemPopupStyle}" Click="TemaClaro_Click"/>
                        <Button Content="Nostalgia" Style="{StaticResource ItemPopupStyle}" Click="TemaNostalgia_Click"/>
                        <Separator Margin="2,4"/>
                        <TextBlock Text="Tamanho" FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource MutedForegroundBrush}" Margin="4,0"/>
                        <StackPanel Orientation="Horizontal" Margin="2,2">
                            <Button Content="P" Style="{StaticResource TamanhoPopupStyle}" Click="TamanhoPequena_Click"/>
                            <Button Content="M" Style="{StaticResource TamanhoPopupStyle}" Click="TamanhoMedia_Click"/>
                            <Button Content="G" Style="{StaticResource TamanhoPopupStyle}" Click="TamanhoGrande_Click"/>
                        </StackPanel>
                        <Separator Margin="2,4"/>

                        <!-- Toggle custom "Iniciar com o Windows" (checkbox nativo destoava do resto da UI) -->
                        <StackPanel Orientation="Horizontal" Margin="4,4" Cursor="Hand" MouseLeftButtonUp="ToggleIniciar_Click">
                            <Border x:Name="TrilhoToggle" Width="30" Height="16" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource MutedForegroundBrush}" Background="Transparent">
                                <Border x:Name="BolinhaToggle" Width="12" Height="12" CornerRadius="6"
                                        Background="{DynamicResource MutedForegroundBrush}"
                                        HorizontalAlignment="Left" Margin="1,0,0,0"/>
                            </Border>
                            <TextBlock Text="Iniciar com o Windows" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ForegroundBrush}" FontSize="{DynamicResource FontSizeSmall}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Lista de tarefas -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <ItemsControl x:Name="ListaTarefas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TarefaItemVM}">
                            <Border Padding="14,7" Background="Transparent" BorderBrush="{DynamicResource TaskLineBrush}" BorderThickness="0,0,0,1"
                                    AllowDrop="True" PreviewMouseLeftButtonDown="ItemTarefa_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ItemTarefa_PreviewMouseMove" Drop="ItemTarefa_Drop">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Adiar para amanhã" Click="AdiarAmanha_Click"
                                                  Visibility="{Binding EhAgendada, Converter={StaticResource BoolParaVisibilidade}}"/>
                                        <MenuItem Header="Escolher nova data..." Click="AdiarEscolherData_Click"
                                                  Visibility="{Binding EhAgendada, Converter={StaticResource BoolParaVisibilidade}}"/>
                                        <Separator Visibility="{Binding EhAgendada, Converter={StaticResource BoolParaVisibilidade}}"/>
                                        <MenuItem Header="Excluir" Click="Excluir_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                            BorderBrush="{DynamicResource AccentBrush}" Cursor="Hand"
                                            MouseLeftButtonUp="Circulo_MouseLeftButtonUp" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Concluida}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Texto}" Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="{DynamicResource FontSizeNormal}" FontFamily="Segoe UI" TextWrapping="Wrap" MaxWidth="160"/>
                                        <TextBlock Text="{Binding DataLabel}" Foreground="{DynamicResource MutedForegroundBrush}"
                                                   FontSize="{DynamicResource FontSizeSmall}" Visibility="{Binding EhAgendada, Converter={StaticResource BoolParaVisibilidade}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Adicionar tarefa -->
            <Grid Grid.Row="2" Margin="10,6,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="PainelInput" Grid.Column="0" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPlaceholder" Text="nova tarefa..." Foreground="{DynamicResource MutedForegroundBrush}"
                               FontSize="{DynamicResource FontSizeNormal}" FontFamily="Segoe UI" IsHitTestVisible="False" Margin="2,0,0,0"/>
                    <TextBox x:Name="TxtNovaTarefa" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}" CaretBrush="{DynamicResource ForegroundBrush}"
                             FontSize="{DynamicResource FontSizeNormal}" VerticalContentAlignment="Center"
                             KeyDown="TxtNovaTarefa_KeyDown" TextChanged="TxtNovaTarefa_TextChanged"/>
                </Grid>

                <Button x:Name="BtnAgendar" Grid.Column="1" Visibility="Collapsed" Width="26" Height="26"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Click="BtnAgendar_Click" ToolTip="Agendar para outro dia">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- Ícone de calendário desenhado na mão (evita depender de glifo de fonte do sistema,
                         que às vezes não renderiza / cai num "tofu box" escuro fixo, ilegível no tema escuro) -->
                    <Grid x:Name="IconeCalendario" Width="14" Height="13" SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource MutedForegroundBrush}" BorderThickness="1.3" CornerRadius="1.5"
                                Margin="0,2,0,0"/>
                        <Line X1="0" Y1="5" X2="14" Y2="5" Stroke="{DynamicResource MutedForegroundBrush}" StrokeThickness="1.3"/>
                        <Line X1="3.5" Y1="0" X2="3.5" Y2="3" Stroke="{DynamicResource MutedForegroundBrush}" StrokeThickness="1.3"/>
                        <Line X1="10.5" Y1="0" X2="10.5" Y2="3" Stroke="{DynamicResource MutedForegroundBrush}" StrokeThickness="1.3"/>
                    </Grid>
                </Button>

                <Button x:Name="BtnAdicionar" Grid.Column="2" Content="+" Width="26" Height="26" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource ForegroundBrush}" FontSize="16" Cursor="Hand" Click="BtnAdicionar_Click"/>
            </Grid>

            <!-- Estatística semanal -->
            <Border Grid.Row="3" Margin="0,0,0,10" Cursor="Hand" Background="Transparent"
                    MouseLeftButtonUp="Estatistica_MouseLeftButtonUp" ToolTip="Ver semana">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="26">
                    <ItemsControl x:Name="ListaEstatistica" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatDiaVM}">
                                <Border Width="8" Height="{Binding AlturaBarra}" Margin="2,0"
                                        Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                        VerticalAlignment="Bottom"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
