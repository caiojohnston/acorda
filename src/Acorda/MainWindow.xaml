<Window x:Class="Acorda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Acorda.ViewModels"
        Title="acorda" Height="460" Width="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade"/>
    </Window.Resources>

    <Border CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <Grid Grid.Row="0" Height="34" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="acorda" Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="BtnConfig" Content="&#x2699;" Width="26" Height="24" Background="Transparent"
                            BorderThickness="0" Foreground="{DynamicResource MutedForegroundBrush}" FontSize="12"
                            Cursor="Hand" Click="BtnConfig_Click" ToolTip="Tema"/>
                    <Button Style="{DynamicResource MinimizeButtonStyle}" Click="Minimizar_Click"/>
                    <Button Style="{DynamicResource CloseButtonStyle}" Click="Fechar_Click"/>
                </StackPanel>
            </Grid>

            <!-- Popup de temas -->
            <Popup x:Name="PopupTemas" PlacementTarget="{Binding ElementName=BtnConfig}" Placement="Bottom" StaysOpen="False">
                <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource MutedForegroundBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="6">
                    <StackPanel>
                        <Button Content="Escuro" Margin="2" Padding="6,3" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource ForegroundBrush}" HorizontalContentAlignment="Left"
                                Click="TemaEscuro_Click" Cursor="Hand"/>
                        <Button Content="Claro" Margin="2" Padding="6,3" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource ForegroundBrush}" HorizontalContentAlignment="Left"
                                Click="TemaClaro_Click" Cursor="Hand"/>
                        <Button Content="Nostalgia" Margin="2" Padding="6,3" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource ForegroundBrush}" HorizontalContentAlignment="Left"
                                Click="TemaNostalgia_Click" Cursor="Hand"/>
                        <Separator Margin="2,4"/>
                        <CheckBox x:Name="ChkIniciarComWindows" Content="Iniciar com o Windows" Margin="4,2"
                                  Foreground="{DynamicResource ForegroundBrush}" Cursor="Hand"
                                  Checked="ChkIniciarComWindows_Changed" Unchecked="ChkIniciarComWindows_Changed"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Lista de tarefas -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                <ItemsControl x:Name="ListaTarefas">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TarefaItemVM}">
                            <Border Padding="14,7" BorderBrush="{DynamicResource TaskLineBrush}" BorderThickness="0,0,0,1">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Adiar para amanhã" Click="AdiarAmanha_Click"
                                                  Visibility="{Binding EhAgendada, Converter={StaticResource BoolParaVisibilidade}}"/>
                                        <MenuItem Header="Escolher nova data..." Click="AdiarEscolherData_Click"
                                                  Visibility="{Binding EhAgendada, Converter={StaticResource BoolParaVisibilidade}}"/>
                                        <Separator Visibility="{Binding EhAgendada, Converter={StaticResource BoolParaVisibilidade}}"/>
                                        <MenuItem Header="Excluir" Click="Excluir_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18" Height="18" CornerRadius="9" BorderThickness="1.5"
                                            BorderBrush="{DynamicResource AccentBrush}" Cursor="Hand"
                                            MouseLeftButtonUp="Circulo_MouseLeftButtonUp" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Concluida}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Texto}" Foreground="{DynamicResource ForegroundBrush}"
                                                   FontSize="13" FontFamily="Segoe UI" TextWrapping="Wrap" MaxWidth="160"/>
                                        <TextBlock Text="{Binding DataLabel}" Foreground="{DynamicResource MutedForegroundBrush}"
                                                   FontSize="10" Visibility="{Binding EhAgendada, Converter={StaticResource BoolParaVisibilidade}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Adicionar tarefa -->
            <Grid Grid.Row="2" Margin="10,6,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtNovaTarefa" Grid.Column="0" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource ForegroundBrush}" FontSize="13" VerticalContentAlignment="Center"
                         KeyDown="TxtNovaTarefa_KeyDown"/>
                <Button x:Name="BtnAgendar" Grid.Column="1" Content="&#x1F4C5;" Width="26" Height="26" Background="Transparent"
                        BorderThickness="0" FontSize="12" Cursor="Hand" Click="BtnAgendar_Click" ToolTip="Agendar para outro dia"/>
                <Button Grid.Column="2" Content="+" Width="26" Height="26" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource ForegroundBrush}" FontSize="16" Cursor="Hand" Click="AdicionarTarefa_Click"/>
            </Grid>

            <!-- Estatística semanal -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10" Height="26">
                <ItemsControl x:Name="ListaEstatistica">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StatDiaVM}">
                            <Border Width="8" Height="{Binding AlturaBarra}" Margin="2,0"
                                    Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                    VerticalAlignment="Bottom" ToolTip="{Binding Tooltip}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</Window>
